* {
  box-sizing: border-box;
}

:root {
  --bg: #08090a;
  --bg-soft: #101214;
  --panel: rgba(255, 255, 255, 0.03);
  --panel-strong: rgba(255, 255, 255, 0.06);
  --line: rgba(255, 255, 255, 0.1);
  --text: #f5f1ea;
  --muted: rgba(245, 241, 234, 0.72);
  --soft-muted: rgba(245, 241, 234, 0.56);
  --accent: #d4c0a1;
  --accent-strong: #f3ddbc;
  --shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: radial-gradient(circle at top left, rgba(255, 255, 255, 0.06), transparent 24%), linear-gradient(180deg, #070809 0%, #0a0b0d 100%);
  color: var(--text);
}

a {
  color: inherit;
}

img {
  display: block;
  max-width: 100%;
}

.container {
  width: min(1180px, calc(100% - 32px));
  margin: 0 auto;
}

.page-shell {
  min-height: 100vh;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(9, 10, 12, 0.65);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}

.nav-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px 0;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  letter-spacing: 0.16em;
  font-weight: 700;
  font-size: 0.76rem;
}

.brand-mark {
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: 1px solid var(--line);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 0.9rem;
  letter-spacing: 0;
}

.main-nav {
  display: flex;
  align-items: center;
  gap: 28px;
}

.main-nav a {
  text-decoration: none;
  color: var(--muted);
  font-size: 0.76rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 22px;
  border-radius: 999px;
  border: 1px solid var(--line);
  text-decoration: none;
  font-weight: 600;
  transition: transform 0.2s ease, border-color 0.2s ease;
}

.btn:hover,
.btn:focus-visible {
  transform: translateY(-1px);
}

.btn-primary {
  color: #111214;
  background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
  border-color: transparent;
  box-shadow: 0 18px 40px rgba(201, 176, 133, 0.22);
}

.btn-outline,
.btn-secondary {
  background: rgba(255, 255, 255, 0.02);
  color: var(--text);
}

.hero {
  padding: 88px 0 64px;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.08fr 0.92fr;
  align-items: center;
  gap: 52px;
}

.eyebrow {
  margin: 0 0 18px;
  color: var(--soft-muted);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 0.7rem;
  font-weight: 600;
}

.hero-copy h1 {
  margin: 0;
  letter-spacing: -0.07em;
  line-height: 0.96;
  font-size: clamp(3.2rem, 5vw, 5.5rem);
  max-width: 620px;
}

.lead {
  margin-top: 20px;
  max-width: 560px;
  color: var(--muted);
  font-size: 1.08rem;
  line-height: 1.8;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 30px;
}

.hero-metrics {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 34px;
  padding: 0;
  margin: 42px 0 0;
}

.hero-metrics li {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 130px;
}

.hero-metrics strong {
  font-size: clamp(1.5rem, 2vw, 2rem);
  letter-spacing: -0.06em;
}

.hero-metrics span {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--soft-muted);
}

.hero-visual {
  position: relative;
  min-height: 580px;
  display: grid;
  place-items: center;
}

.visual-panel {
  width: min(100%, 520px);
  min-height: 520px;
  border: 1px solid var(--line);
  border-radius: 28px;
  background: linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.01));
  box-shadow: var(--shadow);
  overflow: hidden;
}

.panel-header {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 18px 18px 16px;
  border-bottom: 1px solid var(--line);
}

.panel-header span {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255,255,255,0.28);
}

.panel-body {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 22px;
  padding: 28px 22px 22px;
}

.metric-box,
.signal-card {
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(255,255,255,0.02);
}

.metric-box {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 200px;
  padding: 20px;
}

.metric-box small {
  color: var(--soft-muted);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 0.65rem;
}

.metric-box strong {
  font-size: clamp(2.2rem, 3vw, 3.7rem);
  letter-spacing: -0.08em;
}

.signal-card {
  min-height: 200px;
  padding: 18px 18px 14px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.signal-label {
  color: var(--soft-muted);
  text-transform: uppercase;
  letter-spacing: 0.14em;
  font-size: 0.65rem;
}

.signal-graph {
  height: 118px;
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 8px;
}

.signal-graph span {
  display: block;
  width: 100%;
  border-radius: 12px 12px 0 0;
  background: linear-gradient(180deg, var(--accent-strong) 0%, rgba(255,255,255,0.26) 100%);
}

.signal-graph span:nth-child(1) { height: 34%; }
.signal-graph span:nth-child(2) { height: 56%; }
.signal-graph span:nth-child(3) { height: 74%; }
.signal-graph span:nth-child(4) { height: 100%; }

.floating-card {
  position: absolute;
  min-width: 200px;
  padding: 18px 18px 16px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(12, 13, 15, 0.9);
  backdrop-filter: blur(12px);
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.3);
}

.floating-card p {
  margin: 0 0 10px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.62rem;
  color: var(--soft-muted);
}

.floating-card h3 {
  margin: 0;
  font-size: 1.5rem;
  letter-spacing: -0.06em;
}

.card-left {
  left: -16px;
  bottom: 38px;
}

.card-right {
  right: -10px;
  top: 50px;
}

.logos-section {
  padding: 14px 0 0;
}

.logos-wrap {
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  padding: 28px 0;
}

.logos-wrap p {
  margin: 0 0 18px;
  text-align: center;
  color: var(--soft-muted);
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.logo-row {
  display: grid;
  grid-template-columns: repeat(6, minmax(90px, 1fr));
  gap: 18px;
  text-align: center;
}

.logo-row span {
  color: rgba(255,255,255,0.55);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.18em;
}

.section-block {
  padding: 110px 0 30px;
}

.section-header {
  margin-bottom: 34px;
}

.section-header h2 {
  margin: 0;
  max-width: 700px;
  font-size: clamp(2.4rem, 3vw, 3.7rem);
  letter-spacing: -0.06em;
  line-height: 1.05;
}

.projects-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.project-card {
  border: 1px solid var(--line);
  border-radius: 24px;
  background: rgba(255,255,255,0.02);
  overflow: hidden;
}

.project-thumb {
  height: 330px;
  border-bottom: 1px solid var(--line);
  background-size: cover;
  background-position: center;
}

.thumb-one {
  background: linear-gradient(135deg, rgba(255,255,255,0.08), rgba(255,255,255,0.02)), linear-gradient(135deg, #141516, #2c2d2c 40%, #8d8c7f);
}

.thumb-two {
  background: linear-gradient(135deg, rgba(0,0,0,0.1), rgba(255,255,255,0.06)), linear-gradient(135deg, #0b0f11, #3f3d3a 32%, #c7bca7 100%);
}

.thumb-three {
  background: linear-gradient(135deg, rgba(255,255,255,0.09), rgba(255,255,255,0.02)), linear-gradient(135deg, #111315, #4a4440 35%, #d8bd95 100%);
}

.project-info {
  padding: 20px 18px 22px;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  color: var(--soft-muted);
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.project-info h3 {
  margin: 18px 0 8px;
  font-size: 2.1rem;
  letter-spacing: -0.06em;
}

.project-info p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.split-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 30px;
  align-items: start;
}

.studio-copy h2 {
  margin: 0 0 18px;
  font-size: clamp(2.2rem, 3vw, 3.4rem);
  line-height: 1.05;
  letter-spacing: -0.06em;
}

.studio-copy p:not(.eyebrow) {
  margin: 0;
  max-width: 520px;
  color: var(--muted);
  line-height: 1.8;
}

.studio-points {
  display: grid;
  gap: 18px;
}

.point-item {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 18px;
  padding: 18px 0;
  border-top: 1px solid var(--line);
}

.point-item:first-child {
  border-top: 0;
  padding-top: 0;
}

.point-item span {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--soft-muted);
  letter-spacing: -0.06em;
}

.point-item h3 {
  margin: 0 0 8px;
  font-size: 1.5rem;
  letter-spacing: -0.06em;
}

.point-item p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.process-card {
  border: 1px solid var(--line);
  border-radius: 20px;
  background: rgba(255,255,255,0.02);
  padding: 22px 18px 18px;
}

.process-card span {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  border: 1px solid var(--line);
  background: rgba(255,255,255,0.04);
  font-weight: 700;
}

.process-card h3 {
  margin: 22px 0 10px;
  font-size: 1.5rem;
  letter-spacing: -0.06em;
}

.process-card p {
  margin: 0;
  color: var(--muted);
  line-height: 1.7;
}

.testimonial-wrap {
  border: 1px solid var(--line);
  border-radius: 28px;
  background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.012));
  padding: 50px 26px 30px;
  text-align: center;
}

.quote-mark {
  font-size: 5rem;
  line-height: 1;
  color: var(--accent-strong);
  margin-bottom: 10px;
  font-weight: 700;
}

.testimonial-wrap blockquote {
  max-width: 830px;
  margin: 0 auto;
  font-size: clamp(1.5rem, 2vw, 2.4rem);
  line-height: 1.35;
  letter-spacing: -0.05em;
  font-weight: 500;
}

.author {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 28px;
}

.author strong {
  font-size: 1rem;
}

.author span {
  color: var(--soft-muted);
}

.site-footer {
  padding: 80px 0 110px;
}

.footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding-top: 28px;
  border-top: 1px solid var(--line);
}

.footer-inner h2 {
  margin: 0;
  font-size: clamp(2rem, 3vw, 3.2rem);
  letter-spacing: -0.06em;
  line-height: 1.05;
}

.reveal {
  opacity: 0;
  transform: translateY(18px);
  transition: opacity 0.7s ease, transform 0.7s ease;
}

.reveal.visible {
  opacity: 1;
  transform: translateY(0);
}

@media (max-width: 960px) {
  .hero-grid,
  .split-grid,
  .projects-grid,
  .process-grid {
    grid-template-columns: 1fr;
  }

  .hero-visual {
    min-height: 500px;
  }

  .logo-row {
    grid-template-columns: repeat(3, minmax(90px, 1fr));
  }

  .footer-inner {
    flex-direction: column;
    align-items: flex-start;
  }
}

@media (max-width: 680px) {
  .main-nav {
    display: none;
  }

  .hero {
    padding-top: 60px;
  }

  .hero-actions,
  .hero-metrics {
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-visual {
    min-height: 470px;
  }

  .visual-panel {
    min-height: 420px;
  }

  .card-left {
    left: 10px;
    bottom: 18px;
  }

  .card-right {
    right: 10px;
    top: 22px;
  }

  .floating-card {
    min-width: 160px;
  }

  .logo-row {
    grid-template-columns: repeat(2, minmax(90px, 1fr));
  }

  .section-block {
    padding-top: 90px;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  .reveal {
    opacity: 1;
    transform: none;
    transition: none;
  }

  *, *::before, *::after {
    animation: none !important;
    transition: none !important;
  }
}
